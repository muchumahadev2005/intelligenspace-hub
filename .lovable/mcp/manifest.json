{
  "version": 1,
  "sdk_version": "2.0.2",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "ai-agent-console",
      "version": "0.1.0",
      "title": "AI Agent Console"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "List projects",
        "description": "List the developer projects in the workspace with their health scores.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_project",
        "title": "Get project",
        "description": "Get full details for one developer project, including stack and repository structure.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "description": "Project id, e.g. prj_ecom."
            }
          },
          "required": [
            "projectId"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_code_review",
        "title": "Get code review",
        "description": "Get the latest AI code review, including findings, for one project.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "description": "Project id, e.g. prj_ecom."
            }
          },
          "required": [
            "projectId"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_security_findings",
        "title": "List security findings",
        "description": "List security findings, optionally filtered by project id and severity.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "projectId": {
              "description": "Filter to one project id.",
              "type": "string"
            },
            "severity": {
              "description": "Filter to one severity level.",
              "type": "string",
              "enum": [
                "critical",
                "high",
                "medium",
                "low"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_ai_tasks",
        "title": "List AI tasks",
        "description": "List the AI agent task history, optionally filtered by project id or status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "projectId": {
              "description": "Filter to one project id.",
              "type": "string"
            },
            "status": {
              "description": "Filter by task status, e.g. completed, running, failed.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
